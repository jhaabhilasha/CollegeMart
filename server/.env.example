# MongoDB Connection String
# For local development: mongodb://localhost:27017/collegeconnect
# For MongoDB Atlas: Get from Atlas Dashboard -> Database -> Connect -> Drivers
MONGO_URI=mongodb://localhost:27017/collegeconnect

# JWT Secret - Generate a secure random string for production
# You can generate one using: node -e "console.log(require('crypto').randomUUID())"
JWT_SECRET=your-secure-jwt-secret-here

# SendGrid API Key for email functionality (password reset, notifications)
# Get from https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key

# Email address used as sender for outgoing emails
EMAIL_USER=your-email@example.com

# Server port (optional, defaults to 5000)
PORT=5000

# Frontend URL for email verification links (optional, defaults to http://localhost:5173)
# FRONTEND_URL=https://yourdomain.com

# Allowed origins for CORS (comma-separated, for production)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Leave empty to use defaults (localhost:5173, localhost:5174, localhost:3000)
# ALLOWED_ORIGINS=
